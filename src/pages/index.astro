---
import Layout from "../layouts/Layout.astro";
import FeatureCard from "../components/FeatureCard.astro";
import FastCard from "../components/FastCard.astro";
import BenchmarkCard from "../components/BenchmarkCard.astro";
import PricingCard from "../components/PricingCard.astro";

const portalUrl =
  import.meta.env.PUBLIC_PORTAL_URL || "https://portal.fynncloud.ch";
---

<Layout>
  <!-- Hero Section -->
  <section
    id="hero-section"
    class="w-full bg-zinc-950 text-white pt-14 sm:pt-20 border-b border-zinc-800/80"
    data-header-theme="dark"
  >
    <div class="w-full max-w-6xl mx-auto px-6">
      <!-- Hero Header -->
      <div class="mx-auto max-w-3xl text-center pb-8 sm:pb-12">
        <h1
          class="font-bold text-4xl sm:text-5xl md:text-6xl tracking-tight text-white leading-tight text-balance"
        >
          Self-hosted cloud storage that doesn't feel like 2012.
        </h1>

        <p class="mt-5 mx-auto text-base sm:text-lg text-zinc-400 leading-relaxed max-w-2xl text-pretty">
          A fast, compiled alternative to Nextcloud. Written in Swift and Vapor
          so it runs just as smoothly on a Raspberry Pi as it does on a rack
          server.
        </p>

        <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
          <a
            href="#pricing"
            class="inline-flex items-center gap-2 rounded-lg bg-blue-600 hover:bg-blue-500 px-5 py-2.5 text-sm font-semibold text-white transition duration-150 active:scale-99"
          >
            <span>Get Started</span>
            <svg
              class="w-4 h-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2.25"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"></path>
            </svg>
          </a>
          <a
            href="https://github.com/FynnCloudProject"
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 rounded-lg bg-zinc-900 hover:bg-zinc-800 border border-zinc-800 px-5 py-2.5 text-sm font-semibold text-zinc-200 transition duration-150 active:scale-99"
          >
            <svg
              class="w-4 h-4 fill-current text-zinc-400"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                fill-rule="evenodd"
                clip-rule="evenodd"
                d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
              ></path>
            </svg>
            <span>View on GitHub</span>
          </a>
        </div>
      </div>

      <!-- Hero Hardware Mockup -->
      <div class="w-full pt-4 sm:pt-8 pb-16 sm:pb-24">
        <img
          src="/img/HeroMBPBlackWebsite.png"
          alt="FynnCloud Finder Mockup"
          fetchpriority="high"
          class="w-full h-auto select-none pointer-events-none"
        />
      </div>
    </div>
  </section>

  <!-- Native Features Section (Asymmetric Bento Grid) -->
  <section
    id="features"
    class="w-full bg-white text-zinc-950 py-24 sm:py-32 border-b border-zinc-200"
    data-header-theme="light"
  >
    <div class="w-full max-w-6xl mx-auto px-6">
      <div class="max-w-2xl mb-14">
        <h2
          class="text-4xl sm:text-5xl font-extrabold tracking-tight text-zinc-950 leading-tight text-balance"
        >
          Simply beautiful. Entirely native.
        </h2>
        <p class="mt-4 text-base sm:text-lg text-zinc-600 leading-relaxed text-pretty">
          FynnCloud plugs straight into macOS instead of running a heavy
          background app. Browse your drive in Finder, sync changes as they
          happen, and share folders without opening a browser.
        </p>
      </div>

      <!-- 12-Column Asymmetric Bento Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        <FeatureCard
          title="Native macOS integration."
          description="Built on Apple's FileProvider API. Your cloud files show up right in Finder and download on demand, so they don't eat up local disk space."
          spanClass="lg:col-span-7"
          aspectClass="aspect-16/10"
        >
          <img
            src="/img/NativeMacMockup.png"
            alt="FynnCloud Finder Mockup"
            loading="lazy"
            class="w-full h-full object-contain select-none"
          />
        </FeatureCard>

        <FeatureCard
          title="Real-time delta sync."
          description="Only changed bytes and metadata get transferred. Updates propagate immediately without re-scanning your entire folder tree."
          spanClass="lg:col-span-5"
          aspectClass="aspect-16/10 lg:aspect-auto lg:h-full"
        >
          <img
            src="/img/DeltaSyncStatus.png"
            alt="FynnCloud Delta Sync Status"
            loading="lazy"
            class="w-full max-h-80 object-contain select-none"
          />
        </FeatureCard>

        <FeatureCard
          title="Native sharing."
          description="Right-click any file or folder in Finder to grab a share link, set a password, or add an expiration date."
          spanClass="lg:col-span-5"
          aspectClass="aspect-16/10"
        >
          <img
            src="/img/NativeShareMockup.png"
            alt="FynnCloud Finder Native Share Popover"
            loading="lazy"
            class="w-full h-full object-contain select-none"
          />
        </FeatureCard>

        <FeatureCard
          title="Snappy web dashboard."
          description="Need access from another machine? Preview documents, manage users, and check storage from a clean web UI that doesn't take five seconds to load."
          spanClass="lg:col-span-7"
          aspectClass="aspect-16/10"
        >
          <img
            src="/img/ModernWebInterfaceMockup.png"
            alt="FynnCloud Web Interface Mockup"
            loading="lazy"
            class="w-full h-full object-contain select-none"
          />
        </FeatureCard>
      </div>
    </div>
  </section>

  <!-- Engineered for Speed + Benchmarks Section (Unified Hairline Matrix) -->
  <section
    id="architecture"
    class="w-full bg-zinc-950 text-white py-24 sm:py-32 border-b border-zinc-800/80"
    data-header-theme="dark"
  >
    <div class="w-full max-w-6xl mx-auto px-6">
      <div class="max-w-2xl mb-14">
        <h2
          class="text-4xl sm:text-5xl font-bold tracking-tight text-white leading-tight text-balance"
        >
          Engineered for speed.
        </h2>
        <p class="mt-4 text-base sm:text-lg text-zinc-400 leading-relaxed">
          Because FynnCloud compiles to native code, it starts in milliseconds
          and idles under 50 MB of RAM. Even on a Raspberry Pi 5, sync requests
          return almost immediately.
        </p>
      </div>

      <!-- Unified Interlocking Hairline Matrix (Architecture + Benchmarks) -->
      <div
        class="rounded-2xl border border-zinc-800 overflow-hidden bg-zinc-800 space-y-px"
      >
        <!-- Top: 12-Column Architecture Grid -->
        <div
          class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-px bg-zinc-800"
        >
          <FastCard
            title="Powered by Swift."
            description="Compiled directly to native machine code. Swift's structured concurrency handles thousands of parallel sync requests without breaking a sweat."
            spanClass="lg:col-span-4"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-6 h-6 shrink-0"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
            </svg>
          </FastCard>

          <FastCard
            title="Built-in OCR & search."
            description="Search inside PDFs, screenshots, and documents by what they contain, not just what you named the file."
            spanClass="lg:col-span-4"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-6 h-6 shrink-0"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.75"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09ZM18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 0 0-2.456 2.456ZM16.894 20.567 16.5 21.75l-.394-1.183a2.25 2.25 0 0 0-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 0 0 1.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 0 0 1.423 1.423l1.183.394-1.183.394a2.25 2.25 0 0 0-1.423 1.423Z"
              ></path>
            </svg>
          </FastCard>

          <FastCard
            title="Single-binary deployment."
            description="No Apache, no PHP-FPM worker pools, and no sprawling config files. Drop in a single binary or Docker container and you're running."
            spanClass="lg:col-span-4"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-6 h-6 shrink-0"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path
                d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"
              ></path>
              <path d="m3.3 7 8.7 5 8.7-5"></path>
              <path d="M12 22V12"></path>
            </svg>
          </FastCard>

          <FastCard
            title="Zero-copy streaming."
            description="Multi-gigabyte uploads stream straight to disk without buffering in RAM, so large transfers never spike memory usage."
            spanClass="lg:col-span-3"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-6 h-6 shrink-0"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="m16 6-4-4-4 4"></path>
              <path d="M12 2v8"></path>
              <rect width="20" height="8" x="2" y="14" rx="2"></rect>
              <path d="M6 18h.01"></path>
              <path d="M10 18h.01"></path>
            </svg>
          </FastCard>

          <FastCard
            title="SSO & access control."
            description="Hook up OIDC or LDAP for your team, scope API tokens per device, and keep permissions simple."
            spanClass="lg:col-span-3"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-6 h-6 shrink-0"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path
                d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.8 17 5 19 5a1 1 0 0 1 1 1z"
              ></path>
              <path d="m9 12 2 2 4-4"></path>
            </svg>
          </FastCard>

          <FastCard
            title="Local disk or S3."
            description="Point FynnCloud at a local ZFS pool, a mounted NAS, or any S3-compatible bucket."
            spanClass="lg:col-span-3"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-6 h-6 shrink-0"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
              <path d="M3 5V19A9 3 0 0 0 21 19V5"></path>
              <path d="M3 12A9 3 0 0 0 21 12"></path>
            </svg>
          </FastCard>

          <FastCard
            title="Background workers."
            description="Thumbnailing and OCR run on background Redis queues so file uploads and sync polls never get blocked."
            spanClass="md:col-span-2 lg:col-span-3"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-6 h-6 shrink-0"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path
                d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"
              ></path>
              <path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65"></path>
              <path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65"></path>
            </svg>
          </FastCard>
        </div>

        <!-- Bottom: Side-by-Side Raspberry Pi 5 Benchmarks -->
        <div
          id="benchmarks"
          class="grid grid-cols-1 md:grid-cols-2 gap-px bg-zinc-800"
        >
          <BenchmarkCard
            title="Sync Request Latency (TTFB)"
            fynncloudValue="12 ms"
            fynncloudPercent={5}
            nextcloudValue="240 ms"
            comparisonPercent="-95%"
            description="Time to first byte for a delta sync poll on a Raspberry Pi 5"
          >
            <span slot="fynncloud-sub" class="text-zinc-500 font-normal"
              >(Swift + Vapor)</span
            >
          </BenchmarkCard>

          <BenchmarkCard
            title="Server Memory Footprint (Idle)"
            fynncloudValue="42 MB"
            fynncloudPercent={7}
            nextcloudValue="626 MB"
            nextcloudLabel="(Apache + FPM pool)"
            comparisonPercent="-93%"
            description="RAM used by all backend processes at idle on a Raspberry Pi 5"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing Section -->
  <section
    id="pricing"
    class="w-full bg-white text-zinc-950 py-24 sm:py-32 border-b border-zinc-200"
    data-header-theme="light"
  >
    <div class="w-full max-w-6xl mx-auto px-6">
      <!-- Section Header -->
      <div class="max-w-2xl mb-14">
        <h2
          class="text-4xl sm:text-5xl font-extrabold tracking-tight text-zinc-950 leading-tight text-balance"
        >
          Fair. Scalable. Transparent.
        </h2>
        <p class="mt-4 text-base sm:text-lg text-zinc-600 leading-relaxed text-pretty">
          Free for homelabs and up to 10 users. For larger teams, pay $2 per
          user with no seat minimums, or grab a flat-rate subscription for your
          whole organization.
        </p>
      </div>

      <!-- Unified Architectural Pricing Matrix (Estimator + 3 Tiers) -->
      <div class="rounded-2xl border border-zinc-200 overflow-hidden bg-zinc-200 space-y-px">
        <!-- Top Row: Interactive Team Size Estimator -->
        <div class="bg-zinc-50 p-7 sm:p-10">
          <div
            class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center"
          >
            <div class="lg:col-span-7 space-y-5">
              <div class="flex flex-wrap items-baseline justify-between gap-4">
                <div>
                  <h3 class="text-xl sm:text-2xl font-bold tracking-tight text-zinc-950">
                    How many people on your team?
                  </h3>
                  <p class="text-sm text-zinc-500 mt-1">
                    Drag the slider to estimate your annual subscription.
                  </p>
                </div>
                <div
                  class="text-3xl sm:text-4xl font-extrabold text-zinc-950 tabular-nums tracking-tight"
                  id="user-count-display"
                >
                  25 <span class="text-sm font-medium text-zinc-500">users</span>
                </div>
              </div>

              <div class="space-y-3 pt-1">
                <input
                  type="range"
                  id="user-range"
                  min="1"
                  max="150"
                  value="25"
                  class="w-full h-2 bg-zinc-200 rounded-lg appearance-none cursor-pointer accent-blue-600 focus:outline-none"
                  aria-label="Number of users in your team"
                />
                <div
                  class="flex justify-between text-xs text-zinc-500 font-medium select-none"
                >
                  <button
                    type="button"
                    data-slider-preset="1"
                    class="hover:text-zinc-950 transition-colors"
                    >1 User (Homelab)</button
                  >
                  <button
                    type="button"
                    data-slider-preset="50"
                    class="hover:text-zinc-950 transition-colors"
                    >50 Users</button
                  >
                  <button
                    type="button"
                    data-slider-preset="100"
                    class="hover:text-zinc-950 transition-colors"
                    >100 Users</button
                  >
                  <button
                    type="button"
                    data-slider-preset="150"
                    class="hover:text-zinc-950 transition-colors"
                    >150+ Users</button
                  >
                </div>
              </div>
            </div>

            <!-- Live Estimate Output -->
            <div
              class="lg:col-span-5 bg-white border border-zinc-200/90 rounded-xl p-6 sm:p-7 flex flex-col justify-between gap-5"
            >
              <div class="flex items-start justify-between gap-4">
                <div>
                  <div class="text-xs font-medium text-zinc-500">
                    Estimated Subscription
                  </div>
                  <h4
                    class="text-xl font-bold tracking-tight text-zinc-950 mt-0.5"
                    id="fynncloud-calc-tier"
                  >
                    Business Tier
                  </h4>
                  <div
                    class="text-xs text-zinc-500 mt-1 tabular-nums"
                    id="fynncloud-calc-breakdown"
                  >
                    25 users × $2/mo × 12 mos
                  </div>
                </div>
                <div class="text-right">
                  <span
                    class="text-3xl sm:text-4xl font-extrabold tracking-tight text-blue-600 tabular-nums"
                    id="fynncloud-calc-cost">$600</span
                  >
                  <span class="text-xs font-semibold text-zinc-500 block"
                    >per year</span
                  >
                </div>
              </div>

              <ul
                class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs text-zinc-600 border-t border-zinc-100 pt-4"
                id="fynncloud-calc-features"
              >
                <!-- Populated dynamically via JavaScript -->
              </ul>

              <a
                href="#"
                id="fynncloud-calc-cta"
                class="block w-full text-center bg-blue-600 hover:bg-blue-500 active:scale-99 text-white py-3 px-4 rounded-lg text-xs font-semibold transition duration-150"
              >
                Buy Subscription
              </a>
            </div>
          </div>
        </div>

        <!-- Bottom Row: 3-Column Pricing Table -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-zinc-200">
          <PricingCard
            title="Homelab"
            subtitle="For personal servers, families, and self-hosters."
            price="$0"
            priceSuffix="Free forever"
            features={[
              { text: "Up to 10 active users", highlight: true },
              { text: "Native macOS Finder sync" },
              { text: "Built-in OCR & full-text search" },
              { text: "Community support" },
            ]}
            ctaText="Get Started Free"
            ctaHref="https://github.com/FynnCloudProject"
          />

          <PricingCard
            title="Business"
            subtitle="For teams that want an instant subscription key with no sales calls."
            price="$2"
            priceSuffix="/ user / mo"
            extraLabel="Billed annually • Cancel anytime"
            features={[
              { text: "Up to 100 active users", highlight: true },
              { text: "Instant subscription key delivery" },
              { text: "OIDC & LDAP directory sync" },
              { text: "Priority email support" },
            ]}
            ctaText="Buy Subscription"
            ctaTier="business"
            highlighted={true}
          />

          <PricingCard
            title="Enterprise"
            subtitle="Flat-rate annual subscription for larger organizations."
            price="$2,500"
            priceSuffix="/ yr"
            extraLabel="Flat-rate subscription • Unlimited users"
            features={[
              { text: "Unlimited active users", highlight: true },
              { text: "Everything in Business" },
              { text: "Multi-node & Kubernetes support" },
              { text: "Direct engineer support & SLA" },
            ]}
            ctaText="Buy Subscription"
            ctaTier="enterprise"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive script for calculator -->
  <script is:inline>
    (() => {
      const initCalculator = () => {
        const slider = document.getElementById("user-range");
        const userDisplay = document.getElementById("user-count-display");
        const fynncloudCost = document.getElementById("fynncloud-calc-cost");
        const fynncloudTier = document.getElementById("fynncloud-calc-tier");
        const fynncloudBreakdown = document.getElementById(
          "fynncloud-calc-breakdown",
        );
        const fynncloudFeatures = document.getElementById(
          "fynncloud-calc-features",
        );
        const fynncloudCTA = document.getElementById("fynncloud-calc-cta");
        const presetButtons = document.querySelectorAll("[data-slider-preset]");

        if (
          !slider ||
          !userDisplay ||
          !fynncloudCost ||
          !fynncloudTier ||
          !fynncloudBreakdown ||
          !fynncloudFeatures ||
          !fynncloudCTA
        ) {
          return;
        }

        const tierDetails = {
          homelab: {
            features: [
              "Up to 10 active users",
              "Native Finder sync",
              "Built-in OCR & search",
              "Community support",
            ],
            ctaText: "Get Started Free",
            ctaLink: "https://github.com/FynnCloudProject",
          },
          business: {
            features: [
              "Up to 100 active users",
              "Instant subscription key",
              "OIDC & LDAP sync",
              "Priority email support",
            ],
            ctaText: "Buy Subscription",
            ctaLink: "https://github.com/FynnCloudProject",
          },
          enterprise: {
            features: [
              "Unlimited active users",
              "Everything in Business",
              "Multi-node & Kubernetes",
              "Direct engineer SLA",
            ],
            ctaText: "Buy Subscription",
            ctaLink: "https://github.com/FynnCloudProject",
          },
        };

        function updateCalculator() {
          const users = parseInt(slider.value, 10);

          userDisplay.innerHTML = `${users} <span class="text-sm font-medium text-zinc-500">user${users > 1 ? "s" : ""}</span>`;

          let fynnAnnual = 0;
          let tierName = "";
          let fynnBreakdownText = "";
          let currentTierKey = "homelab";

          if (users <= 10) {
            fynnAnnual = 0;
            tierName = "Homelab Tier";
            fynnBreakdownText = "Free up to 10 users";
            currentTierKey = "homelab";
          } else {
            const businessCost = users * 2 * 12;
            if (businessCost <= 2500) {
              fynnAnnual = businessCost;
              tierName = "Business Tier";
              fynnBreakdownText = `${users} users × $2/mo × 12 mos`;
              currentTierKey = "business";
            } else {
              fynnAnnual = 2500;
              tierName = "Enterprise Tier";
              currentTierKey = "enterprise";
              if (users < 100) {
                fynnBreakdownText = "Capped at the flat Enterprise rate";
              } else {
                fynnBreakdownText = "Flat rate, unlimited users";
              }
            }
          }

          fynncloudCost.textContent =
            fynnAnnual === 0 ? "$0" : `$${fynnAnnual.toLocaleString()}`;
          fynncloudTier.textContent = tierName;
          fynncloudBreakdown.textContent = fynnBreakdownText;

          const tier = tierDetails[currentTierKey];
          fynncloudFeatures.innerHTML = tier.features
            .map(
              (feature) => `
              <li class="flex items-center gap-2">
                <svg class="w-3.5 h-3.5 text-blue-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
                </svg>
                <span>${feature}</span>
              </li>
            `,
            )
            .join("");

          fynncloudCTA.textContent = tier.ctaText;
          if (currentTierKey === "business") {
            fynncloudCTA.href = "#";
            fynncloudCTA.setAttribute("data-checkout-tier", "business");
            fynncloudCTA.setAttribute("data-quantity", users.toString());
            fynncloudCTA.removeAttribute("target");
          } else if (currentTierKey === "enterprise") {
            fynncloudCTA.href = "#";
            fynncloudCTA.setAttribute("data-checkout-tier", "enterprise");
            fynncloudCTA.setAttribute("data-quantity", "1");
            fynncloudCTA.removeAttribute("target");
          } else {
            fynncloudCTA.href = tier.ctaLink;
            fynncloudCTA.removeAttribute("data-checkout-tier");
            fynncloudCTA.removeAttribute("data-quantity");
            fynncloudCTA.setAttribute("target", "_blank");
          }
        }

        slider.addEventListener("input", updateCalculator);

        presetButtons.forEach((btn) => {
          btn.addEventListener("click", () => {
            const val = btn.getAttribute("data-slider-preset");
            if (val) {
              slider.value = val;
              updateCalculator();
            }
          });
        });

        updateCalculator();
      };

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initCalculator);
      } else {
        initCalculator();
      }
    })();
  </script>

