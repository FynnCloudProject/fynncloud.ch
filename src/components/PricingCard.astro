---
interface Feature {
  text: string;
  highlight?: boolean;
}

interface Props {
  title: string;
  subtitle: string;
  price: string;
  priceSuffix?: string;
  extraLabel?: string;
  features: Feature[];
  ctaText: string;
  ctaHref?: string;
  ctaTier?: string;
  highlighted?: boolean;
}

const {
  title,
  subtitle,
  price,
  priceSuffix,
  extraLabel,
  features,
  ctaText,
  ctaHref,
  ctaTier,
  highlighted = false,
} = Astro.props;

const cardClasses = highlighted
  ? "bg-zinc-950 text-white p-8 sm:p-9 flex flex-col justify-between relative"
  : "bg-white text-zinc-950 p-8 sm:p-9 flex flex-col justify-between relative";

const buttonClasses = highlighted
  ? "block w-full text-center bg-blue-600 hover:bg-blue-500 active:scale-99 text-white py-3 px-4 rounded-lg text-xs font-semibold transition duration-150"
  : "block w-full text-center bg-zinc-950 hover:bg-zinc-800 active:scale-99 text-white py-3 px-4 rounded-lg text-xs font-semibold transition duration-150";

const isExternal =
  ctaHref && (ctaHref.startsWith("http://") || ctaHref.startsWith("https://"));
---

<div class={cardClasses}>
  <div class="space-y-7">
    <div>
      <h3
        class={`text-2xl font-bold tracking-tight ${highlighted ? "text-white" : "text-zinc-950"}`}
      >
        {title}
      </h3>
      <p
        class={`text-sm mt-2 leading-relaxed ${highlighted ? "text-zinc-400" : "text-zinc-500"}`}
      >
        {subtitle}
      </p>
    </div>

    <div class="space-y-1.5">
      <div class="flex items-baseline">
        <span
          class={`text-4xl sm:text-5xl font-extrabold tracking-tight tabular-nums ${highlighted ? "text-white" : "text-zinc-950"}`}
        >
          {price}
        </span>
        {
          priceSuffix && (
            <span
              class={`text-sm font-medium ml-2 ${highlighted ? "text-zinc-400" : "text-zinc-500"}`}
            >
              {priceSuffix}
            </span>
          )
        }
      </div>
      {
        extraLabel ? (
          <div
            class={`text-xs font-medium ${highlighted ? "text-blue-400" : "text-zinc-500"}`}
          >
            {extraLabel}
          </div>
        ) : (
          <div class="text-xs text-zinc-400 font-medium">
            No credit card required
          </div>
        )
      }
    </div>

    <div
      class={`border-t pt-6 ${highlighted ? "border-zinc-800" : "border-zinc-200"}`}
    >
      <ul
        class={`space-y-3.5 text-sm ${highlighted ? "text-zinc-300" : "text-zinc-600"}`}
      >
        {
          features.map((feature) => (
            <li class="flex items-center gap-3">
              <svg
                class={`w-4 h-4 shrink-0 ${highlighted ? "text-blue-400" : "text-blue-600"}`}
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2.5"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M5 13l4 4L19 7"
                />
              </svg>
              {feature.highlight ? (
                <span
                  class={`font-semibold ${highlighted ? "text-white" : "text-zinc-950"}`}
                >
                  {feature.text}
                </span>
              ) : (
                <span>{feature.text}</span>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="mt-10">
    {
      ctaHref ? (
        <a
          href={ctaHref}
          target={isExternal ? "_blank" : undefined}
          rel={isExternal ? "noopener" : undefined}
          class={buttonClasses}
        >
          {ctaText}
        </a>
      ) : (
        <button class={buttonClasses} data-checkout-tier={ctaTier}>
          {ctaText}
        </button>
      )
    }
  </div>
</div>
