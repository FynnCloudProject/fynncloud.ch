---
interface Props {
  title: string;
  description: string;
  spanClass?: string;
}
const { title, description, spanClass = "" } = Astro.props;
---

<div
  class={`bg-zinc-950 p-7 sm:p-8 flex flex-col justify-between gap-8 transition-colors duration-200 hover:bg-zinc-900/60 ${spanClass}`}
>
  <div class="text-blue-500">
    <slot />
  </div>
  <div>
    <h3 class="text-lg font-semibold text-white tracking-tight">{title}</h3>
    <p class="text-sm text-zinc-400 leading-relaxed mt-2">{description}</p>
  </div>
</div>
