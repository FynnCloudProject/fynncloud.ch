---
interface Props {
  title: string;
  description: string;
  spanClass?: string;
  aspectClass?: string;
}
const {
  title,
  description,
  spanClass = "",
  aspectClass = "aspect-16/10",
} = Astro.props;
---

<div
  class={`group rounded-2xl bg-zinc-100 border border-zinc-200/80 overflow-hidden flex flex-col justify-between transition-colors duration-200 hover:border-zinc-300 ${spanClass}`}
>
  <div class="p-7 sm:p-8 pb-2">
    <h3 class="text-xl font-bold tracking-tight text-zinc-950">{title}</h3>
    <p class="mt-2 text-sm sm:text-base text-zinc-600 leading-relaxed max-w-lg">
      {description}
    </p>
  </div>

  <div
    class={`w-full ${aspectClass} px-4 sm:px-6 pb-4 sm:pb-6 pt-2 flex items-center justify-center select-none overflow-hidden`}
  >
    <slot />
  </div>
</div>
